<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <%- include('partials/header') %>
        <main>
            <h1>
                <%= category.name %>
            </h1>

            <% if (projects.length> 0) { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li><a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a></li>
                        <% }); %>
                </ul>
                <% } else { %>
                    <p>No service projects in this category yet.</p>
                    <% } %>
        </main>
        <%- include('partials/footer') %>
</body>

</html>